# Base directory for the game user (louis)
BASE_DIR=/home/louis

# Installation subdirectory name (e.g., l4d2, cstrike)
INSTALL_DIR=l4d2

# Game subdirectory name (e.g., left4dead2, cstrike) – used for -game parameter
GAME_NAME=left4dead2

# Steam App ID for the game
GAME_ID=222860

# Whether to install/update plugins automatically (true/false)
INSTALL_PLUGINS=true

# Default map to load when server starts
DEFAULT_MAP=c2m1_highway

# Server port (UDP/TCP)
PORT=27015

# IP address to bind (0.0.0.0 for all interfaces)
IP=0.0.0.0

# Clock correction in milliseconds
CLOCK_CORRECTION_MSECS=25

# Connection timeout in seconds
TIMEOUT=10

# Server tickrate (updates per second)
TICKRATE=100

# Server configuration file to execute (relative to game dir)
EXEC_CFG=server.cfg

# Maximum number of players (leave empty or 0 for default)
MAXPLAYERS=8

# Timezone for the container (e.g., Asia/Shanghai, UTC, America/New_York)
TZ=Asia/Shanghai

# SSH public key for the 'louis' user (optional). Leave empty to disable SSH access.
# Format: "ssh-ed25519 AAAA... comment" or "ssh-rsa AAA... comment"
SSH_PUBLIC_KEY=

# SSH server port (used for sshd_config at container startup)
SSH_PORT=22